{
  "package_id": "corridor_traffic_exposure",
  "version": "v1",
  "title": "Corridor Traffic Exposure Intelligence",
  "purpose": {
    "primary": "infrastructure_siting",
    "allowed": [
      "infrastructure_siting",
      "aggregate_measurement"
    ],
    "blocked": [
      "individual_targeting",
      "restricted_audience_building",
      "unapproved_investigative_use"
    ]
  },
  "inputs": {
    "required": [
      "mobility.vehicle.corridor.weekly.synthetic.v1",
      "road.network.segment.v1",
      "fhwa.hpms.aadt.v1"
    ],
    "optional": [
      "events.local_disruption.v1",
      "freight.node_context.v1"
    ]
  },
  "outputs": [
    "corridor_exposure_score",
    "segment_exposure",
    "peak_period_share",
    "underserved_segment_score",
    "baseline_aadt_agreement",
    "confidence_band"
  ],
  "privacy": {
    "min_subjects": 50,
    "min_time_window": "P7D",
    "suppress_protected_locations": true,
    "raw_identifiers_allowed": false
  },
  "confidence": {
    "strategy": "weighted_corridor_public_baseline"
  },
  "lineage": {
    "required": true,
    "evidence_bundle_required": true
  }
}
