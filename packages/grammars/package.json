{
  "name": "@socioprophet/synapseiq-grammars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "synapseiq-mapping-lint": "dist/cli.js"
  },
  "files": ["dist", "tree-sitter-synapseiq-mapping/grammar.js", "tree-sitter-synapseiq-mapping/grammar.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "echo 'lint not yet configured'",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  }
}
